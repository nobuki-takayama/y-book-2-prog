*/

def ex3b_forM2() {
  import("ot_deRham.rr");
  import("nk_restriction.rr");
  TT=ot_deRham.m_ann([x1,x2,z0+z1*x1^2+z2*x2+z3*x1*x2],[x1,x2] | param=[z0,z1,z2,z3]);
  Rule=[[s_1,15/2],[s_2,7/5],[s_3,-11/3]]$ T=base_replace(TT,Rule);
  Int=nk_restriction.integration(T,[x1,x2],[dx1,dx2],[1,1] | param=[z0,z1,z2,z3]);
  return [Int,T];
}
T=ex3b_forM2();
print(T2=base_replace(T[1],[[z0,1],[z1,1],[z2,1],[z3,1]]))$

end$