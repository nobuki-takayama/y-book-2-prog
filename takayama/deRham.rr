/*
  2024-01-01-deRham.rr を y-book 掲載用に cosmetic change したもの.
*/
def ex2b() {
  import("ot_deRham.rr");
  import("nk_restriction.rr");
  T=ot_deRham.m_ann([p1,z0+z1*p1+z2*p1^2+z3*p1^3],[p1] | param=[z0,z1,z2,z3]);
  Rule=[[s_1,15/2],[s_2,-11/3]]$ T=base_replace(T,Rule);
  Int=nk_restriction.integration(T,[p1],[dp1],[1] | param=[z0,z1,z2,z3]);
  return [Int,T];
}
//T=ex2b();
/*
 A=[[1,1,1,1],[0,1,2,3]]
  出力
 [[],[[2],[1],[0]]]
  は p1^2, p1^1, p1^0 に dp1 を掛けたものが basis であることを意味する.
  Ann は
  [(-dp1*p1^4-7/2*p1^3)*z3+(-dp1*p1^3+1/6*p1^2)*z2+(-dp1*p1^2+23/6*p1)*z1+(-dp1*p1+15/2)*z0]  
*/

def ex3b() {
  import("ot_deRham.rr");
  import("nk_restriction.rr");
  TT=ot_deRham.m_ann([p1,p2,z0+z1*p1^2+z2*p2+z3*p1*p2],[p1,p2] | param=[z0,z1,z2,z3]);
  Rule=[[s_1,15/2],[s_2,7/5],[s_3,-11/3]]$ T=base_replace(TT,Rule);
  Int=nk_restriction.integration(T,[p1,p2],[dp1,dp2],[1,1] | param=[z0,z1,z2,z3]);
  return [Int,T];
}
T=ex3b(); print(T);

