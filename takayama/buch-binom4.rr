extern N;
N=5;
/*
  モノミアル - モノミアル
  -モノミアル + モノミアル
  (binomial) 専用のグレブナー基底.  割り算しても同じ形.
  [係数, 指数]
 例: モノミアルの格納方法: [-1,2,0,3] は -x^2*y^0*z^3
*/
def new_monom() {
  return newvect(N+1);
}

/*
  lexicographic order でモノミアルを比較.
*/
def comp(A,B) {
  for (I=1; I<=N; I++) {
    if (A[I] > B[I]) return 1;
    if (A[I] < B[I]) return -1;
  }
  return 0;
}

/*
  A を B で割れるか? (A は B で reducible か?)
  割れる場合は商を戻す.
*/
def is_reducible(A,B) {
  if (A==0) return 0;
  C=new_monom();
  C[0]=-A[0]/B[0];
  for (I=1; I<=N; I++) {
    C[I]=A[I]-B[I];
    if (C[I] < 0) return 0;
  }
  return C;
}

/*
   係数付きモノミアルの掛け算.
*/
def mymul(A,B) {
  C=new_monom();
  C[0]=A[0]*B[0];
  for (I=1; I<=N; I++) {
    C[I]=A[I]+B[I];
  }
  return C;
}

/*
  binomial F を binomial G で割る(F を G で reduce).
  
*/
def reduce(F,G) {
  if (F==0) return F;
  C=is_reducible(F[0],G[0]);
  if (!C) return G;
  if (length(F)==1) return [mymul(C,G[1])];
  A=F[1];
  B=mymul(C,G[1]);
  R=comp(A,B);
  if (R==1) return [A,B];
  else if (R == -1) return [B,A];
  else {
    if (A[0]+B[0]==0) return 0;
    else {
      C=new_monom();
      C[0]=A[0]+B[0];
      for (I=1; I<=N; I++) C[I]=A[I];
      return [C];
    }
  }
}

/* reduce のテスト */
reduce(F=[newvect(N+1,[1,2,0,1]),newvect(N+1,[-1,1,1,1])],
       G=[newvect(N+1,[1,1,0,1]),newvect(N+1,[-1,0,0,1])]);

/* 問題:
  1. 複数の binomials で reduce する(割り算する)
  2. fully reduce 
  3. S-多項式の計算
  4. Buchberger algorithm の適用.
  5. reduced GB の計算
*/
/* 2022.06.20  buch-binom3.rr で追加 */

/* F は binomial.
   G は binomial の集合
*/
def reduce2(F,G) {
  Reduced=1;
  while (Reduced) {
    Reduced=0;
    for (I=0; I<length(G); I++) {
      if (F==0) return F;
      C=is_reducible(F[0],G[I][0]);
      if (C) {
	Reduced=1;
        Fnew=reduce(F,G[I]);
        printf("%a --> %a  by %a\n",F,Fnew,G[I]);
        F=Fnew;
      }
    }
  }
  return F;
}

G2=[[newvect(N+1,[1, 1,0, 0,0,0]),newvect(N+1,[-1, 0,0, 1,0,0])],
    [newvect(N+1,[1, 1,1, 0,0,0]),newvect(N+1,[-1, 0,0, 0,1,0])],
    [newvect(N+1,[1, 1,2, 0,0,0]),newvect(N+1,[-1, 0,0, 0,0,1])]]$
//F2= [newvect(N+1,[1, 2,2, 0,0,0]),newvect(N+1,[-1, 0,0, 0,2,0])]$
F2= [newvect(N+1,[1, 2,2, 0,0,0])]$
reduce2(F2,G2);

def spolynomial(F,G) {
  E=newvect(N+1);
  for (I=1; I<=N; I++) {
    if (F[0][I]>G[0][I]) E[I]=F[0][I]; else E[I]=G[0][I]; // LCM
  }
  E1=E-F[0]; E1[0]=G[0][0];
  E2=E-G[0]; E2[0]=F[0][0]; 
  A=mymul(E1,F[1]); B=mymul(E2,G[1]); B[0]=-B[0];
  R=comp(A,B);
  if (R>0) return [A,B];
  else if (R<0) return [B,A];
  else {
    if (A[0]+B[0]==0) return 0;
    else {A[0]=A[0]+B[0]; return [A];}
  }
}
printf("spoly(%a,%a)=%a\n",G2[0],G2[1],spolynomial(G2[0],G2[1]))$

def buchberger(F)
{
  NN = length(F);
  Pairs = [];
  for ( I = NN-1; I >= 0; I-- )
    for ( J = NN-1; J > I; J-- )
      Pairs = cons([I,J],Pairs);
  G = F;
  while ( Pairs != [] ) {
    P = car(Pairs);
    Pairs = cdr(Pairs);
    Sp = spolynomial(G[P[0]],G[P[1]]);
    Rem = reduce2(Sp,G);
    if ( Rem ) {
      G = append(G,[Rem]);
      for ( I = 0; I < NN; I++ )
        Pairs = cons([I,NN],Pairs);
      NN++;
    }
  }
  return to_minimal(G);
}
def is_reducible_by_set(F,Set) {
  for (I=0; I<length(Set); I++) {
    if (Mon=is_reducible(F[0],Set[I][0])) return [Mon,I];
  }
  return 0;
}
def to_minimal(S) {
  G=[];
  while (S != []) {
    F=car(S); S=cdr(S);
    if (is_reducible_by_set(F,append(S,G))) continue; else G = cons(F,G);
  }
  return G;
}

def eliminate(G,M) {
  return base_prune(0,map(eliminate1,G,M));
}
def eliminate1(G,M) {
  if (G==0) return G;
  for (I=1; I<=M; I++) {
    if (G[0][I] != 0) return 0;
  }
  return G;
}

G3=buchberger(G2);
eliminate(G3,2);





